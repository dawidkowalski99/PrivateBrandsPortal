@model IReadOnlyList<ImplementationQueueItem>
@{ViewData["Title"]="Implementation Approvals";}
<div class="page-heading"><div><p class="eyebrow">MANAGER WORKSPACE</p><h1>Implementation Approvals</h1><p>Review documents before Sales &amp; Delivery. Your own projects are excluded.</p></div><a class="btn btn-outline-secondary" asp-controller="Approvals" asp-action="Index">Project approvals</a></div>
@if(TempData["Success"] is string message){<div class="alert alert-success">@message</div>}
@if(Model.Count==0){<section class="panel empty-state"><h2>All caught up</h2><p>No implementation requests awaiting your review.</p></section>}
<div class="product-grid">@foreach(var item in Model){<article class="panel product-card"><h2>@item.ProjectNumber</h2><p>@item.Customer · @item.Owner</p><h3>@item.Category — @item.Subcategory</h3><p>SKU: <strong>@item.SKU</strong></p><span class="stage-badge">Pending</span><p>Offer: @(item.Offer?"Available":"Missing")<br/>Calculation: @(item.Calculation?"Available":"Missing")</p><p>Requested: @item.RequestedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC</p><a class="btn btn-primary" asp-action="Review" asp-route-id="@item.Id">Review</a></article>}</div>
