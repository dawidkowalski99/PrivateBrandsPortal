@model ProductCardViewModel
<h3>@Model.ProductType</h3>
<dl class="product-data"><div><dt>Product Category</dt><dd>@(Model.Category ?? "Not assigned (legacy)")</dd></div><div><dt>Subcategory</dt><dd>@Model.ProductType</dd></div>
<div class="wide"><dt>SKU</dt><dd>@Model.SKU</dd></div>
<div><dt>Quantity</dt><dd>@Model.Quantity.ToString("N0")</dd></div>
<div><dt>Estimated Value</dt><dd>@Model.EstimatedValue.ToString("N2") <small>PLN</small></dd></div>
<div><dt>Estimated Margin</dt><dd>@Model.EstimatedMargin.ToString("N2")%</dd></div>
<div><dt>Formula</dt><dd>@if(Model.FormulaName is not null){@Model.FormulaName}else{@Html.DisplayFor(x => x.FormulaStatus)}</dd></div>
</dl>
