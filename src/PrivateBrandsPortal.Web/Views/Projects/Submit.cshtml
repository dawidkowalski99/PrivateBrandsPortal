@model ProjectDetailsViewModel
@{ ViewData["Title"] = Model.RequiresManagerApproval ? "Submit for Approval" : "Finalize project"; }
<section class="panel form-panel">
<p class="eyebrow">@(Model.RequiresManagerApproval ? "MANAGER REVIEW" : "COMMERCIAL WORKFLOW")</p><h1>@(Model.RequiresManagerApproval ? "Submit project for manager review?" : "Finalize project?") @Model.ProjectNumber</h1>
<p>@(Model.RequiresManagerApproval ? "After submission, the draft is locked for manager review." : "Separate manager approval is not required. Finalizing locks the draft and makes its products available for commercial updates.")</p>
<form asp-action="Submit" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="version" value="@Model.UpdatedAtUtc.ToString("O")" />
<div class="form-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-primary" type="submit">@(Model.RequiresManagerApproval ? "Submit" : "Finalize project")</button></div></form>
</section>
