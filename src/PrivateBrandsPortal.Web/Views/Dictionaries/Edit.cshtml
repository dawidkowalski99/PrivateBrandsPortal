@model DictionaryInput
@{ViewData["Title"]=Model.Id==0?"Add entry":"Edit entry";}
<div class="page-heading"><h1>@ViewData["Title"]</h1></div>
<form method="post" class="panel form-panel"><div asp-validation-summary="All" class="validation-summary"></div><input asp-for="Id" type="hidden"/><input asp-for="Kind" type="hidden"/><input name="Version" value="@Model.Version?.ToString("O")" type="hidden"/>
<div class="form-grid"><div class="field"><label asp-for="Name"></label><input asp-for="Name" class="form-control" required maxlength="100"/><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="DisplayOrder"></label><input asp-for="DisplayOrder" class="form-control" min="0" max="100000"/><span asp-validation-for="DisplayOrder"></span></div></div>
@if(Model.Kind==DictionaryKind.Countries){<div class="field"><label asp-for="Code"></label><input asp-for="Code" class="form-control" required maxlength="2" pattern="[A-Za-z]{2}"/><span asp-validation-for="Code"></span></div>}
@if(Model.Kind!=DictionaryKind.Countries){<div class="field"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control" maxlength="1000"></textarea></div>}<label class="mt-3"><input asp-for="IsActive"/> Active</label>
@if(Model.Kind==DictionaryKind.RejectionReasons){<label class="mt-3 ms-3"><input asp-for="RequiresComment"/> Comment required</label><p class="wizard-note">The comment requirement for Other, or an entry already requiring a comment, cannot be removed.</p>}
<div class="form-actions"><a asp-action="Index" asp-route-kind="@Model.Kind" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-primary">Save</button></div></form>
