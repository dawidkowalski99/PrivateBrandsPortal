@model DictionaryInput
@{ViewData["Title"]="Delete dictionary value";}
<section class="panel form-panel"><h1>Delete dictionary value?</h1><h2>@Model.Name</h2><p>This action is only possible if the value is unused. Existing history and references cannot be removed.</p><form method="post"><input asp-for="Id" type="hidden"/><input asp-for="Kind" type="hidden"/><input type="hidden" name="version" value="@Model.Version?.ToString("O")"/><div class="form-actions"><a asp-action="Index" asp-route-kind="@Model.Kind" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-danger">Delete</button></div></form></section>
