@inject PrivateBrandsPortal.Web.Interfaces.IAppUserService Users
@inject PrivateBrandsPortal.Web.Interfaces.IPermissionService Permissions
@using PrivateBrandsPortal.Web.Services
@using PrivateBrandsPortal.Web.Models.Enums
@{var actor=await Users.GetCurrentAsync();var canDelete=actor.IsActive && actor.Role is AppRole.Manager or AppRole.SuperAdmin;var canEdit=await Permissions.HasAsync(PermissionCodes.ManageDictionaries);}
@model DictionaryPage
@{ViewData["Title"]=Model.Kind switch { DictionaryKind.CustomerRejectionReasons=>"Customer Rejection Reasons",DictionaryKind.FormulaOptions=>"Formula Options",DictionaryKind.ProductCategories=>"Product Categories",DictionaryKind.Countries=>"Countries",DictionaryKind.Customers=>"Customers",DictionaryKind.ProductSubcategories=>"Product Subcategories",_=>"Rejection Reasons" };}
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>@ViewData["Title"]</h1><p>Deactivate entries to keep historical references available.</p></div>@if(canEdit){<a class="btn btn-primary" asp-action="Edit" asp-route-kind="@Model.Kind">+ Add</a>}</div>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}
@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<form method="get" class="panel form-panel mb-4"><input type="hidden" name="kind" value="@Model.Kind"/><label for="dictionary-search">Search</label><div class="input-group"><input id="dictionary-search" name="search" value="@Model.Search" maxlength="200" class="form-control"/>@if(Model.Kind==DictionaryKind.ProductSubcategories){<select name="categoryId" class="form-select" aria-label="Product Category"><option value="">All categories</option>@foreach(var category in Model.Categories){<option value="@category.Id" selected="@(category.Id==Model.CategoryId)">@category.Name</option>}</select>}<button class="btn btn-outline-primary">Search</button></div></form>
<section class="panel"><div class="table-responsive"><table class="table project-table"><thead><tr><th>Name</th><th>@(Model.Kind==DictionaryKind.ProductSubcategories?"Category":Model.Kind is DictionaryKind.Customers or DictionaryKind.Countries or DictionaryKind.FormulaOptions?"Code":"Description")</th>@if(Model.Kind==DictionaryKind.Customers){<th>Default Country</th>}<th>Order</th><th>Active</th><th></th></tr></thead><tbody>
@foreach(var row in Model.Items){<tr><td>@row.Name</td><td>@(row.CategoryName ?? row.Code ?? row.Description)</td>@if(Model.Kind==DictionaryKind.Customers){<td>@(row.DefaultCountryName ?? "—")</td>}<td>@row.DisplayOrder</td><td>@(row.IsActive?"Active":"Inactive")</td><td>@if(canEdit){<a asp-action="Edit" asp-route-kind="@Model.Kind" asp-route-id="@row.Id">Edit</a>} @if(canDelete){<a class="text-danger ms-3" asp-action="Delete" asp-route-kind="@Model.Kind" asp-route-id="@row.Id">Delete</a>}</td></tr>}
</tbody></table></div></section>
