@inject PrivateBrandsPortal.Web.Interfaces.IAppUserService Users
@inject PrivateBrandsPortal.Web.Interfaces.IPermissionService Permissions
@using PrivateBrandsPortal.Web.Services
@{ ViewData["Title"] = "Administration"; }
<div class="page-heading"><div><p class="eyebrow">ACCESS &amp; REFERENCE DATA</p><h1>Administration</h1><p>Maintain access and the reference data behind your projects.</p></div></div>
@if(await Permissions.HasAsync(PermissionCodes.ManageUsers)){
<div class="admin-grid"><a class="panel admin-card" asp-controller="Users" asp-action="Index"><h2>Users</h2><p>Roles, permissions and account availability.</p></a></div>
}
@if(await Permissions.HasAsync(PermissionCodes.ManageDictionaries) || (await Users.GetCurrentAsync()).Role == PrivateBrandsPortal.Web.Models.Enums.AppRole.Manager){
<h2 class="mt-4">Dictionaries</h2><div class="admin-grid">
@foreach(var item in new[]{("CustomerRejectionReasons","Customer Rejection Reasons"),("FormulaOptions","Formula Options"),("Customers","Customers"),("ProductSubcategories","Product Subcategories"),("Countries","Countries"),("ProductCategories","Product Categories"),("RejectionReasons","Rejection Reasons")}){
<a class="panel admin-card" asp-controller="Dictionaries" asp-action="Index" asp-route-kind="@item.Item1"><h2>@item.Item2</h2><p>Add, edit or deactivate entries.</p></a>
}</div>
}else{<section class="panel form-panel mt-4"><h2>Dictionaries</h2><p>Ask a user administrator for Manage dictionaries access.</p></section>}
