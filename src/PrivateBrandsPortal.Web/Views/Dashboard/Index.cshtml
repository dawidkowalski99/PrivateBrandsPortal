@{ ViewData["Title"] = "Dashboard"; }
<div class="page-heading"><div><p class="eyebrow">YOUR WORKSPACE, CONNECTED</p><h1>Dashboard</h1><p>A clear view of your Private Brands projects.</p></div><span class="stage-badge">Foundation ready</span></div>
<section class="metrics" aria-label="Project overview">
@foreach (var metric in new[] { ("My Active Projects", "Projects you are working on", "◫"), ("Awaiting Approval", "Waiting for manager review", "◷"), ("Recently Changed", "Updates to your products", "↗"), ("Completed", "Projects delivered", "✓") })
{
<article class="metric-card"><div class="metric-top"><span>@metric.Item1</span><span class="metric-icon" aria-hidden="true">@metric.Item3</span></div><strong class="metric-value" aria-label="Not available">—</strong><p>@metric.Item2</p></article>
}
</section>
<section class="panel"><div class="panel-heading"><div><h2>Recent Projects</h2><p>Your latest briefs and product updates.</p></div><a class="text-link" asp-controller="Projects" asp-action="Index">View projects →</a></div>
<div class="empty-state"><span class="empty-icon" aria-hidden="true">▤</span><h3>Your next project starts here</h3><p>Briefs, products and their progress will appear in this workspace.<br />Project creation will be added in the next stages.</p><span class="subtle-badge">No project data connected yet</span></div></section>
<div class="info-strip"><span class="info-symbol" aria-hidden="true">i</span><div><strong>A foundation for the whole project journey</strong><p>The workspace is ready. Brief creation, product review and change history will be introduced step by step.</p></div></div>
