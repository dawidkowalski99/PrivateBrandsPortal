@model CustomerClosureModel
@{ViewData["Title"]="Close product";}
<div class="page-heading"><div><p class="eyebrow">@Model.ProjectNumber · @Model.SKU</p><h1>Product rejected by Customer</h1></div></div>
<form method="post" class="panel form-panel"><div asp-validation-summary="All" class="validation-summary"></div><input asp-for="Input.ProjectId" type="hidden"/><input asp-for="Input.ProductId" type="hidden"/><input type="hidden" name="Input.Version" value="@Model.Input.Version?.ToString("O")"/>
<p class="alert alert-warning">This closes only this SKU. Other products remain unchanged. The project moves to Archive only when all products are terminal. History and documents are preserved.</p>
<div class="field"><label asp-for="Input.ReasonId"></label><select asp-for="Input.ReasonId" class="form-select" required><option value="">Select reason</option>@foreach(var reason in Model.Reasons){<option value="@reason.Id">@reason.Name</option>}</select><span asp-validation-for="Input.ReasonId"></span></div>
<div class="field"><label asp-for="Input.Comment"></label><textarea asp-for="Input.Comment" class="form-control" maxlength="1000"></textarea></div>
<label class="mt-3"><input asp-for="Input.Confirm" required/> I confirm closing this product.</label>
<div class="form-actions"><a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Input.ProjectId" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-outline-danger">Close product</button></div></form>
