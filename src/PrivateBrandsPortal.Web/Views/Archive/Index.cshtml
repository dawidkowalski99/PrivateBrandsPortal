@model IReadOnlyList<ArchiveItem>
@{ViewData["Title"]="Archive";}
<div class="page-heading"><div><p class="eyebrow">COMPLETED DELIVERY</p><h1>Archive</h1><p>Your completed projects. All product decisions and history remain available.</p></div></div>
<form method="get" class="panel form-panel mb-4"><label for="project-search">Search</label><div class="input-group"><input id="project-search" name="search" value="@ViewData["Search"]" maxlength="200" placeholder="Project number, customer or SKU" class="form-control"/><button class="btn btn-outline-primary">Search</button></div></form>
@if(!string.IsNullOrWhiteSpace(ViewData["Search"] as string) && Model.Count==0){<p role="status">No matching projects.</p>}
<section class="panel">@if(Model.Count==0){<div class="empty-state"><h2>@(string.IsNullOrWhiteSpace(ViewData["Search"] as string)?"No archived projects yet":"No matching projects")</h2><p>Projects appear here after completed delivery or closure by Customer rejection.</p></div>}else{
<div class="table-responsive"><table class="table project-table"><thead><tr><th>Project Number</th><th>Customer</th><th>Country</th><th>Project Manager</th><th>Products</th><th>Completed</th><th>Outcome</th><th>Archived At (UTC)</th><th></th></tr></thead><tbody>
@foreach(var p in Model){<tr><td>@p.ProjectNumber</td><td>@p.Customer</td><td>@p.Country</td><td>@p.ProjectManager</td><td>@p.Products</td><td>@p.Completed</td><td>@(p.CustomerRejectionReason is null ? "Completed — Sales & Delivery" : "Closed — Customer not approved")@if(p.CustomerRejectionReason is not null){<p>@p.CustomerRejectionReason</p>}</td><td>@p.ArchivedAtUtc?.ToString("dd.MM.yyyy HH:mm")</td><td><a asp-controller="Projects" asp-action="Details" asp-route-id="@p.Id">View</a></td></tr>}
</tbody></table></div>}</section>
