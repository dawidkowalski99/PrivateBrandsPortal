@model IReadOnlyList<ArchiveItem>
@{ViewData["Title"]="Archive";}
<div class="page-heading"><div><p class="eyebrow">COMPLETED DELIVERY</p><h1>Archive</h1><p>Your completed projects. All product decisions and history remain available.</p></div></div>
<section class="panel">@if(Model.Count==0){<div class="empty-state"><h2>No archived projects yet</h2><p>Projects appear here when every accepted SKU reaches Sales and delivery and review is complete.</p></div>}else{
<div class="table-responsive"><table class="table project-table"><thead><tr><th>Project Number</th><th>Customer</th><th>Country</th><th>Project Manager</th><th>Products</th><th>Completed</th><th>Archived At (UTC)</th><th></th></tr></thead><tbody>
@foreach(var p in Model){<tr><td>@p.ProjectNumber</td><td>@p.Customer</td><td>@p.Country</td><td>@p.ProjectManager</td><td>@p.Products</td><td>@p.Completed</td><td>@p.ArchivedAtUtc?.ToString("dd.MM.yyyy HH:mm")</td><td><a asp-controller="Projects" asp-action="Details" asp-route-id="@p.Id">View</a></td></tr>}
</tbody></table></div>}</section>
