@model ReportPage
@inject PrivateBrandsPortal.Web.Interfaces.IPermissionService Permissions
@using PrivateBrandsPortal.Web.Models.Enums
@{ViewData["Title"]="Reports";}
<div class="page-heading"><div><p class="eyebrow">PORTFOLIO ANALYTICS</p><h1>Reports</h1><p>Project and SKU performance across Project Managers. Dates use project creation time in UTC.</p></div>@if(await Permissions.HasAsync(PrivateBrandsPortal.Web.Services.PermissionCodes.ExportReports)){<a asp-action="Export" asp-all-route-data="Model.Filter.Routes(1)" class="btn btn-primary">Export CSV</a>}</div>
<form method="get" class="panel form-panel report-filters"><div asp-validation-summary="All" class="validation-summary"></div><div class="form-grid">
<div class="field"><label asp-for="Filter.ProjectManagerId"></label><select asp-for="Filter.ProjectManagerId" class="form-select"><option value="">All Project Managers</option>@foreach(var x in Model.Users){<option value="@x.Id">@x.Name</option>}</select></div>
<div class="field"><label asp-for="Filter.DateFrom"></label><input asp-for="Filter.DateFrom" type="date" class="form-control"/></div>
<div class="field"><label asp-for="Filter.DateTo"></label><input asp-for="Filter.DateTo" type="date" class="form-control"/></div>
<div class="field"><label asp-for="Filter.CountryId"></label><select asp-for="Filter.CountryId" class="form-select"><option value="">All countries</option>@foreach(var x in Model.Countries){<option value="@x.Id">@x.Name</option>}</select></div>
<div class="field"><label asp-for="Filter.ProjectStatus"></label><select asp-for="Filter.ProjectStatus" asp-items="Html.GetEnumSelectList<ProjectStatus>()" class="form-select"><option value="">All project statuses</option></select></div>
<div class="field"><label asp-for="Filter.ReviewStatus"></label><select asp-for="Filter.ReviewStatus" asp-items="Html.GetEnumSelectList<ProductReviewStatus>()" class="form-select"><option value="">All manager decisions</option></select></div>
<div class="field"><label asp-for="Filter.CommercialStatus"></label><select asp-for="Filter.CommercialStatus" asp-items="Html.GetEnumSelectList<CommercialStatus>()" class="form-select"><option value="">All commercial statuses</option></select></div>
<div class="field"><label asp-for="Filter.ProductCategoryId"></label><select asp-for="Filter.ProductCategoryId" class="form-select"><option value="">All categories / legacy</option>@foreach(var x in Model.Categories){<option value="@x.Id">@x.Name</option>}</select></div>
<div class="field"><label asp-for="Filter.Subcategory"></label><input asp-for="Filter.Subcategory" maxlength="100" class="form-control"/></div>
<div class="field"><label asp-for="Filter.Customer"></label><input asp-for="Filter.Customer" maxlength="200" class="form-control"/></div>
<div class="field"><label asp-for="Filter.Archived"></label><select asp-for="Filter.Archived" asp-items="Html.GetEnumSelectList<ArchiveFilter>()" class="form-select"></select></div>
</div><div class="form-actions"><a asp-action="Index" class="btn btn-outline-secondary">Clear Filters</a><button class="btn btn-primary">Apply Filters</button></div></form>
<div class="report-kpis" aria-label="Filtered totals">@foreach(var item in new[]{("Projects",Model.Totals.Projects),("SKUs",Model.Totals.SKUs),("Approved SKUs",Model.Totals.Approved),("Edited & Approved SKUs",Model.Totals.EditedApproved),("Rejected SKUs",Model.Totals.Rejected),("Sales & Delivery SKUs",Model.Totals.Delivered)}){<div class="panel"><span>@item.Item1</span><strong>@item.Item2</strong></div>}</div>
<p class="wizard-note">Approved and Edited &amp; Approved are separate counts. Projects counts distinct projects represented by the filtered SKUs.</p>
<section class="panel"><div class="panel-heading"><h2>By Project Manager</h2></div><div class="table-responsive"><table class="table project-table"><thead><tr><th>Project Manager</th><th>Projects</th><th>SKUs</th><th>Approved</th><th>Edited &amp; Approved</th><th>Rejected</th><th>Sales &amp; Delivery</th></tr></thead><tbody>
@foreach(var m in Model.Managers){<tr><td>@m.Name</td><td>@m.Totals.Projects</td><td>@m.Totals.SKUs</td><td>@m.Totals.Approved</td><td>@m.Totals.EditedApproved</td><td>@m.Totals.Rejected</td><td>@m.Totals.Delivered</td></tr>}
</tbody></table></div></section>
<section class="panel mt-4"><div class="panel-heading"><h2>SKU details</h2><span>@Model.Totals.SKUs results</span></div>@if(Model.Rows.Count==0){<div class="empty-state"><h3>No matching SKUs</h3><p>Adjust or clear the filters.</p></div>}else{<div class="table-responsive"><table class="table project-table report-table"><thead><tr><th>Project Number</th><th>Project Manager</th><th>Customer</th><th>Country</th><th>Project Status</th><th>Category</th><th>Subcategory</th><th>SKU</th><th>Quantity</th><th>Estimated Value</th><th>Margin</th><th>Manager Decision</th><th>Rejection Reason</th><th>Commercial Status</th><th>Created (UTC)</th><th>Archived (UTC)</th></tr></thead><tbody>
@foreach(var r in Model.Rows){<tr><td>@r.ProjectNumber</td><td>@r.ProjectManager</td><td>@r.Customer</td><td>@r.Country</td><td>@EnumLabel.Text(r.ProjectStatus)</td><td>@(r.Category??"Legacy / not assigned")</td><td>@r.Subcategory</td><td>@r.SKU</td><td>@r.Quantity.ToString("N0")</td><td>@r.EstimatedValue.ToString("N2") PLN</td><td>@r.EstimatedMargin.ToString("N2")%</td><td>@EnumLabel.Text(r.ReviewStatus)</td><td>@r.RejectionReason</td><td>@(r.CommercialStatus.HasValue?EnumLabel.Text(r.CommercialStatus.Value):r.ReviewStatus is ProductReviewStatus.Approved or ProductReviewStatus.EditedAndApproved?"Awaiting PM update":"—")</td><td>@r.CreatedAtUtc.ToString("dd.MM.yyyy")</td><td>@r.ArchivedAtUtc?.ToString("dd.MM.yyyy HH:mm")</td></tr>}
</tbody></table></div>}
<div class="form-actions">@if(Model.Filter.Page>1){<a asp-action="Index" asp-all-route-data="Model.Filter.Routes(Model.Filter.Page-1)" class="btn btn-outline-secondary">Previous</a>}<span>Page @Model.Filter.Page of @Model.Pages · 50 rows per page</span>@if(Model.Filter.Page<Model.Pages){<a asp-action="Index" asp-all-route-data="Model.Filter.Routes(Model.Filter.Page+1)" class="btn btn-outline-secondary">Next</a>}</div></section>
