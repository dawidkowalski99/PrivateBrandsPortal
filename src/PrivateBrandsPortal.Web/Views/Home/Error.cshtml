@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<section class="panel empty-state"><h1>We could not complete this request</h1><p>Please try again. If the problem continues, contact your portal administrator.</p><p>Request ID: <code>@Model.RequestId</code></p><a class="text-link" asp-controller="Dashboard" asp-action="Index">Return to Dashboard</a></section>
