@model ProductCardViewModel
@using PrivateBrandsPortal.Web.Models.Enums
@if(Model.ReviewStatus is ProductReviewStatus.Approved or ProductReviewStatus.EditedAndApproved){
<section class="manager-changes"><h4>PM Status</h4>
@if(Model.CommercialStatus==CommercialStatus.SalesAndDelivery){<span class="stage-badge project-status-Approved">Completed</span>}
<p>@(Model.CommercialStatus.HasValue ? EnumLabel.Text(Model.CommercialStatus.Value) : "Awaiting PM update")</p>
@if(Model.CommercialStatus!=CommercialStatus.SalesAndDelivery && ViewData["ReadOnly"] is not true && ViewData["Archived"] is not true){<a class="btn btn-outline-secondary" asp-controller="Commercial" asp-action="Change" asp-route-projectId="@ViewData["ProjectId"]" asp-route-productId="@Model.Id">Change status</a>}
<partial name="_ImplementationHistory" model="Model"/>
@if(Model.CommercialStatus==CommercialStatus.ImplementationIntoProduction && ViewData["ReadOnly"] is not true && ViewData["Archived"] is not true && (Model.ImplementationHistory.Count==0 || Model.ImplementationHistory.Last().Status==ImplementationApprovalStatus.Rejected)){
<form method="post" asp-controller="Implementation" asp-action="Resubmit"><input type="hidden" name="projectId" value="@ViewData["ProjectId"]"/><input type="hidden" name="productId" value="@Model.Id"/><input type="hidden" name="version" value="@(((DateTimeOffset?)ViewData["ProjectVersion"])?.ToString("O"))"/><button class="btn btn-outline-primary mt-3">Submit for implementation approval</button></form>}
@if(Model.CommercialHistory.Count>0){<details><summary>Commercial Status History (@Model.CommercialHistory.Count)</summary>@foreach(var change in Model.CommercialHistory){<div class="manager-change"><p><del>@change.OldDisplay</del> → <ins>@change.NewDisplay</ins></p><small>@change.ChangedBy · @change.ChangedAtUtc.ToString("dd.MM.yyyy HH:mm:ss") UTC</small></div>}</details>}
</section>}
