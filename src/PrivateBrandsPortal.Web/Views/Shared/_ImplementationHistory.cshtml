@model ProductCardViewModel
@if(Model.ImplementationHistory.Count>0){<section class="manager-changes"><h4>Implementation Approval: @Model.ImplementationHistory.Last().Status</h4><details><summary>Implementation approval history (@Model.ImplementationHistory.Count)</summary>@foreach(var item in Model.ImplementationHistory){<div class="manager-change"><strong>@item.Status</strong><p>Requested by @item.RequestedBy · @item.RequestedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC</p>@if(item.Reviewer is not null){<p>@item.Reviewer · @item.ReviewedAtUtc?.ToString("dd.MM.yyyy HH:mm") UTC</p>}<p>@item.Comment</p></div>}</details>@if(Model.ImplementationHistory.Last().Status==PrivateBrandsPortal.Web.Models.Enums.ImplementationApprovalStatus.Rejected){<p class="alert alert-warning">@Model.ImplementationHistory.Last().Comment</p>}</section>}
